[Unit]
Description=Mirror /media/med_2tb to /srv/store/med_2tb_mirror
Documentation=https://github.com/Chris1221/homelab/blob/main/conf/systemd/README.md
# Do not run unless both filesystems are mounted. Without this, an unmounted
# /srv/store would make rsync --delete write 400+ GB onto the root disk, and an
# unmounted /media/med_2tb would make it delete the whole mirror.
RequiresMountsFor=/media/med_2tb /srv/store
After=media-med_2tb.mount srv-store.mount

[Service]
Type=oneshot
Nice=10
IOSchedulingClass=idle
ExecStartPre=/usr/bin/mountpoint -q /media/med_2tb
ExecStartPre=/usr/bin/mountpoint -q /srv/store
ExecStart=/usr/bin/rsync -aHx --delete --delete-excluded --numeric-ids \
    --exclude-from=/etc/med_2tb_mirror.exclude \
    --stats --human-readable \
    /media/med_2tb/ /srv/store/med_2tb_mirror/
# Only runs if rsync succeeded. Read by the backup-status dashboard; kept outside
# the mirror dir so --delete doesn't remove it.
ExecStartPost=/usr/bin/touch /srv/store/.med_2tb_mirror_last_success
